---
import { nav, site } from '../config';
import { basePath, withBase } from '../lib/site';

const pathname = Astro.url.pathname;
const currentPath = basePath && pathname.startsWith(basePath)
  ? pathname.slice(basePath.length) || '/'
  : pathname;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name} 홈으로`}>
      <span class="brand__name">{site.nameEn}</span>
    </a>

    <nav class="site-nav" aria-label="주요 메뉴">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-tools">
      <button
        class="icon-btn search-toggle"
        type="button"
        id="search-toggle"
        aria-label="글 검색 열기"
        aria-expanded="false"
        aria-controls="header-search"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
      </button>

      <form
        class="header-search"
        id="header-search"
        role="search"
        action={withBase('/search/')}
        method="get"
      >
        <label class="sr-only" for="header-search-input">검색어</label>
        <input
          id="header-search-input"
          type="search"
          name="q"
          placeholder="글 검색"
          autocomplete="off"
          enterkeyhint="search"
        />
        <button class="header-search__submit" type="submit" aria-label="검색하기">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
        </button>
        <button class="header-search__close" type="button" id="search-close" aria-label="검색 닫기">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
          </svg>
        </button>
      </form>

      {
        site.socials.instagram && (
          <a
            class="icon-btn header-social"
            href={site.socials.instagram}
            target="_blank"
            rel="me noopener"
            aria-label="인스타그램"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <rect x="3.6" y="3.6" width="16.8" height="16.8" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        )
      }
      {
        site.socials.github && (
          <a
            class="icon-btn header-social"
            href={site.socials.github}
            target="_blank"
            rel="me noopener"
            aria-label="깃허브"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.6a9.4 9.4 0 0 0-3 18.3c.5.1.6-.2.6-.5v-1.7c-2.6.6-3.2-1.2-3.2-1.2-.4-1.1-1-1.4-1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.1-.2-4.3-1-4.3-4.6 0-1 .4-1.9 1-2.6-.1-.2-.4-1.2.1-2.5 0 0 .8-.3 2.6 1a9 9 0 0 1 4.8 0c1.8-1.3 2.6-1 2.6-1 .5 1.3.2 2.3.1 2.5a3.7 3.7 0 0 1 1 2.6c0 3.6-2.2 4.4-4.3 4.6.3.3.6.9.6 1.8v2.7c0 .3.2.6.6.5A9.4 9.4 0 0 0 12 2.6Z" />
            </svg>
          </a>
        )
      }

      <noscript>
        <a class="icon-btn" href={withBase('/search/')} aria-label="글 검색 페이지로">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
        </a>
      </noscript>
    </div>
  </div>
</header>

<script>
  (() => {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('search-toggle');
    const form = document.getElementById('header-search') as HTMLFormElement | null;
    const close = document.getElementById('search-close');
    const input = document.getElementById('header-search-input') as HTMLInputElement | null;
    if (!header || !toggle || !form || !input) return;

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-search-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        window.setTimeout(() => input.focus({ preventScroll: true }), 30);
      } else if (document.activeElement === input) {
        toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('is-search-open'));
    });

    close?.addEventListener('click', () => setOpen(false));

    form.addEventListener('submit', (event) => {
      if (!input.value.trim()) {
        event.preventDefault();
        input.focus();
      }
    });

    document.addEventListener('keydown', (event) => {
      const isOpen = header.classList.contains('is-search-open');
      if (event.key === 'Escape' && isOpen) {
        setOpen(false);
      }
      if (event.key === '/' && !isOpen) {
        const target = event.target as HTMLElement | null;
        const tag = target?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea' || target?.isContentEditable) return;
        event.preventDefault();
        setOpen(true);
      }
    });

    document.addEventListener('click', (event) => {
      if (!header.classList.contains('is-search-open')) return;
      if (!header.contains(event.target as Node)) setOpen(false);
    });
  })();
</script>
