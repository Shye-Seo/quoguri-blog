---
/**
 * 롤링 마키 띠
 *
 * 히어로 아래에 전체 폭으로 흐르는 한 줄 띠입니다.
 * 같은 트랙을 두 번 그려 -50% 만큼 움직여 끊김 없이 반복합니다.
 * 움직임을 줄이기 설정(prefers-reduced-motion)에서는 멈춰 있습니다.
 */
import { site } from '../config';

const words = [...site.marquee, ...site.marquee];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <div class="marquee__group">
        {words.map((word) => (
          <span class="marquee__item">
            {word}
            <span class="marquee__dot">◆</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
