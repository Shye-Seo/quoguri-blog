---
/**
 * 브랜드 마크 — 그림 파일 없이 그리는 'Q' 모노그램.
 * 어떤 크기에서도 깨지지 않고, 다크 모드에서도 색이 자동으로 맞습니다.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className = '' } = Astro.props;
---

<span class={`brand-mark ${className}`} style={`--mark-size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 40 40" width={size} height={size} fill="none" role="presentation">
    <rect width="40" height="40" rx="12" fill="currentColor" />
    <circle cx="19" cy="18.6" r="8" stroke="var(--mark-ink, #fbf7f0)" stroke-width="2.4" />
    <path
      d="M22.8 23.2 28.2 29"
      stroke="var(--mark-ink, #fbf7f0)"
      stroke-width="2.4"
      stroke-linecap="round"
    />
  </svg>
</span>
