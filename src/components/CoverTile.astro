---
/**
 * 타이포그래피 커버
 *
 * 사진이 없는 글은 카테고리 색 타일로 채웁니다.
 * 작은 썸네일(카드·목록)은 그림 없이 이모지 한 개만, 히어로 크기에서는
 * 카테고리 이름과 quoguri 마크를 함께 보여 줍니다.
 */
import type { categories } from '../config';

interface Props {
  category: (typeof categories)[number];
  /** 01, 02 … 목록에서의 순번 */
  index?: string;
  variant?: 'card' | 'hero' | 'row';
}

const { category, index, variant = 'card' } = Astro.props;
---

<span
  class={`cover cover--${variant}`}
  style={`--accent:${category.accent}`}
  aria-hidden="true"
>
  {variant === 'hero' && <span class="cover__cat">{category.short}</span>}
  <span class="cover__badge">{category.emoji}</span>
  {
    variant === 'hero' && (
      <span class="cover__foot">
        <span class="cover__rule"></span>
        <span class="cover__mark">quoguri</span>
      </span>
    )
  }
  {variant === 'hero' && index && <span class="cover__no">{index}</span>}
</span>
