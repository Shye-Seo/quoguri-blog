---
import type { Post } from '../lib/posts';
import { categoryOf } from '../lib/posts';
import { asset, formatDateShort, readingTime, withBase } from '../lib/site';
import CoverTile from './CoverTile.astro';

interface Props {
  post: Post;
  eager?: boolean;
  /** 목록 순번 (01, 02…) — 사진이 없을 때 커버에 표시됩니다. */
  index?: string;
}

const { post, eager = false, index } = Astro.props;
const category = categoryOf(post);
const href = withBase(`/posts/${post.id}/`);
const altText = post.data.coverAlt ?? `${post.data.title} 대표 이미지`;
---

<article class="post-card" style={`--accent:${category.accent}`}>
  <a class="post-card__media" href={href} tabindex="-1" aria-hidden="true">
    {
      post.data.cover ? (
        <img
          src={asset(post.data.cover)}
          alt={altText}
          width="1600"
          height="1000"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <CoverTile category={category} index={index} />
      )
    }
  </a>
  <div class="post-card__body">
    <a class="chip chip--category" href={withBase(`/category/${category.slug}/`)}>
      {category.label}
    </a>
    <h3 class="post-card__title"><a href={href}>{post.data.title}</a></h3>
    <p class="post-card__desc">{post.data.description}</p>
    <div class="post-card__foot">
      <time datetime={post.data.pubDate.toISOString()}>{formatDateShort(post.data.pubDate)}</time>
      <span>{readingTime(post.body ?? '')}분 읽기</span>
    </div>
  </div>
</article>
