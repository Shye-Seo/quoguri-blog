---
/**
 * 게임 미리보기 그림
 *
 * 외부 이미지 없이 SVG로 그립니다. /game/ 쇼케이스 카드와
 * 홈의 게임 미리보기에서 같은 그림을 씁니다.
 */
interface Props {
  kind: 'pet' | 'tangerine';
  /** 쇼케이스용이면 조금 더 크게 그립니다 */
  large?: boolean;
}

const { kind, large = false } = Astro.props;
---

<div class:list={['game-preview', `game-preview--${kind}`, { 'game-preview--lg': large }]} aria-hidden="true">
  {
    kind === 'pet' ? (
      <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" role="presentation">
        <defs>
          <linearGradient id="pet-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#F0E9FB" />
            <stop offset="55%" stop-color="#F7F1FB" />
            <stop offset="100%" stop-color="#FAF3E3" />
          </linearGradient>
          <linearGradient id="pet-shell" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#CBB8F3" />
            <stop offset="100%" stop-color="#B09BE8" />
          </linearGradient>
        </defs>
        <rect width="400" height="320" fill="url(#pet-bg)" />
        <g opacity="0.5" fill="#B3A0E8">
          <path d="M58 66l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" />
          <path d="M334 236l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" />
          <path d="M316 74l2.4 6.4 6.4 2.4-6.4 2.4-2.4 6.4-2.4-6.4-6.4-2.4 6.4-2.4z" />
        </g>
        <g opacity="0.65" fill="#E3C98A">
          <circle cx="84" cy="238" r="3.6" />
          <circle cx="352" cy="140" r="3" />
          <circle cx="46" cy="164" r="2.4" />
        </g>

        <!-- 기기 -->
        <g transform="translate(200 166) scale(0.94)">
          <path d="M-7-118a10 10 0 1 1 14 0" fill="none" stroke="#8E7AC9" stroke-width="5.5" stroke-linecap="round" />
          <ellipse cx="0" cy="0" rx="104" ry="116" fill="url(#pet-shell)" />
          <ellipse cx="0" cy="0" rx="104" ry="116" fill="none" stroke="#9C87D9" stroke-width="2" opacity="0.4" />
          <ellipse cx="-36" cy="-54" rx="32" ry="20" fill="#FFFFFF" opacity="0.2" />

          <!-- 화면 -->
          <rect x="-70" y="-62" width="140" height="126" rx="16" fill="#FFFDF8" stroke="#E6DFF2" stroke-width="2" />
          <rect x="-64" y="-56" width="128" height="114" rx="11" fill="#FCF9F1" />

          <!-- 쿼구리 -->
          <g transform="translate(0 -2)">
            <ellipse cx="-33" cy="-33" rx="13" ry="14" fill="#F2E1C6" stroke="#DCC7A4" stroke-width="2" />
            <ellipse cx="33" cy="-33" rx="13" ry="14" fill="#F2E1C6" stroke="#DCC7A4" stroke-width="2" />
            <ellipse cx="0" cy="0" rx="48" ry="42" fill="#F8EAD2" stroke="#E4CFAC" stroke-width="2" />
            <circle cx="-18" cy="-8" r="5" fill="#3B3A32" />
            <circle cx="18" cy="-8" r="5" fill="#3B3A32" />
            <circle cx="-16" cy="-10" r="1.6" fill="#FFFDF8" />
            <circle cx="20" cy="-10" r="1.6" fill="#FFFDF8" />
            <circle cx="-26" cy="8" r="7" fill="#F2B6BC" opacity="0.72" />
            <circle cx="26" cy="8" r="7" fill="#F2B6BC" opacity="0.72" />
            <ellipse cx="0" cy="3" rx="4.4" ry="3.4" fill="#C99A86" />
            <path d="M-7 10q7 7 14 0" fill="none" stroke="#3B3A32" stroke-width="3" stroke-linecap="round" />
          </g>

          <!-- 버튼 -->
          <g transform="translate(0 90)">
            <circle cx="-47" cy="0" r="12" fill="#FFFDF8" stroke="#D9CFF0" stroke-width="2" />
            <circle cx="0" cy="0" r="13" fill="#F7EEDC" stroke="#E4D6BC" stroke-width="2" />
            <circle cx="47" cy="0" r="12" fill="#FFFDF8" stroke="#D9CFF0" stroke-width="2" />
          </g>
        </g>

        <!-- 말풍선 -->
        <g transform="translate(292 58)">
          <rect x="-54" y="-21" width="108" height="42" rx="21" fill="#FFFFFF" stroke="#E6E3DC" stroke-width="1.5" />
          <text x="0" y="6" text-anchor="middle" font-family="Pretendard, sans-serif" font-size="13" font-weight="600" fill="#262822">배고파요…</text>
        </g>
      </svg>
    ) : (
      <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" role="presentation">
        <defs>
          <linearGradient id="tan-bg" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0%" stop-color="#FBF3E2" />
            <stop offset="65%" stop-color="#F9EEDC" />
            <stop offset="100%" stop-color="#F3E6D2" />
          </linearGradient>
        </defs>
        <rect width="400" height="320" fill="url(#tan-bg)" />
        <g stroke="#E8DCC7" stroke-width="1" opacity="0.55">
          <path d="M0 62h400M0 142h400M0 222h400" />
        </g>

        <!-- 점수판 -->
        <g transform="translate(24 24)">
          <rect x="0" y="0" width="88" height="30" rx="15" fill="#FFFFFF" stroke="#E6E3DC" />
          <text x="14" y="20" font-family="Pretendard, sans-serif" font-size="12" font-weight="700" fill="#262822">120점</text>
          <circle cx="70" cy="15" r="4" fill="#E3C98A" />
        </g>
        <g transform="translate(286 26)">
          <rect x="0" y="0" width="76" height="30" rx="15" fill="#FFFFFF" stroke="#E6E3DC" />
          <text x="14" y="20" font-family="Pretendard, sans-serif" font-size="12" font-weight="700" fill="#262822">42초</text>
        </g>

        <!-- 떨어지는 귤 -->
        <g transform="translate(94 96)">
          <circle r="17" fill="#EF9F4A" />
          <circle cx="-5" cy="-5" r="5" fill="#F8C98C" opacity="0.8" />
          <path d="M0-17c2-7 8-10 13-9-1 6-6 10-13 9z" fill="#8CA181" />
        </g>
        <g transform="translate(300 118)">
          <circle r="14" fill="#EF9F4A" />
          <circle cx="-4" cy="-4" r="4" fill="#F8C98C" opacity="0.8" />
          <path d="M0-14c2-6 7-8 11-7-1 5-5 8-11 7z" fill="#8CA181" />
        </g>
        <g transform="translate(206 56)">
          <circle r="11" fill="#EF9F4A" />
          <path d="M0-11c1-5 5-7 9-6-1 4-4 6-9 6z" fill="#8CA181" />
        </g>
        <g transform="translate(148 192)">
          <path d="M0-13l4 8 9 1-6.5 6 1.5 9-8-4.5-8 4.5 1.5-9-6.5-6 9-1z" fill="#E8C24E" stroke="#D6AF3B" stroke-width="1" />
        </g>
        <g transform="translate(342 208)">
          <circle r="12" fill="#3A3A34" />
          <circle cx="-3" cy="-3" r="3" fill="#6B6B60" />
          <path d="M8-9c5-4 9-1 9 4" fill="none" stroke="#8A7A63" stroke-width="2" stroke-linecap="round" />
          <circle cx="17" cy="-4" r="2.4" fill="#E3C98A" />
        </g>

        <!-- 바구니 쿼구리 -->
        <g transform="translate(200 256) scale(0.94)">
          <ellipse cx="-32" cy="-40" rx="10" ry="11" fill="#F2E1C6" stroke="#DCC7A4" stroke-width="2" />
          <ellipse cx="32" cy="-40" rx="10" ry="11" fill="#F2E1C6" stroke="#DCC7A4" stroke-width="2" />
          <path d="M-52-26h104l-10 52a10 10 0 0 1-10 8h-64a10 10 0 0 1-10-8z" fill="#F8EAD2" stroke="#E4CFAC" stroke-width="2" />
          <path d="M-50-16h100M-46 6h92M-40 26h80" stroke="#EAD9BC" stroke-width="2" />
          <circle cx="-17" cy="-12" r="4" fill="#3B3A32" />
          <circle cx="17" cy="-12" r="4" fill="#3B3A32" />
          <circle cx="-25" cy="0" r="5.4" fill="#F2B6BC" opacity="0.7" />
          <circle cx="25" cy="0" r="5.4" fill="#F2B6BC" opacity="0.7" />
          <path d="M-6 0q6 6 12 0" fill="none" stroke="#3B3A32" stroke-width="2.6" stroke-linecap="round" />
        </g>
      </svg>
    )
  }
</div>
