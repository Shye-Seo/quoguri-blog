---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverTile from '../../components/CoverTile.astro';
import { categories, site } from '../../config';
import { absoluteUrl, formatDateShort, withBase } from '../../lib/site';
import { getPublishedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts.filter((post) => post.data.category === category.slug),
    },
  }));
}

const { category, posts } = Astro.props as {
  category: (typeof categories)[number];
  posts: Post[];
};

const title = `${category.label} 글 모음`;
const pageUrl = absoluteUrl(`/category/${category.slug}/`);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category.label} 글 모음`,
    url: pageUrl,
    description: `${category.label} — ${category.blurb}. 쿼구리 블로그의 ${category.label} 글 ${posts.length}편.`,
    inLanguage: 'ko-KR',
    isPartOf: { '@type': 'WebSite', name: site.name, url: absoluteUrl('/') },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: posts.length,
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absoluteUrl(`/posts/${post.id}/`),
        name: post.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '카테고리', item: absoluteUrl('/categories/') },
      { '@type': 'ListItem', position: 3, name: category.label, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={`${category.label} — ${category.blurb}. 쿼구리 블로그의 ${category.label} 카테고리 글 ${posts.length}편.`}
  jsonLd={jsonLd}
>
  <div class="container" style={`--accent:${category.accent}`}>
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li><a href={withBase('/categories/')}>카테고리</a></li>
        <li aria-current="page">{category.label}</li>
      </ol>
    </nav>

    <header class="page-head page-head--accent">
      <p class="eyebrow">category</p>
      <h1 class="page-head__title">{category.label}</h1>
      <p class="page-head__desc">{category.blurb}. 지금까지 {posts.length}편을 기록했어요.</p>
      <div class="chip-row">
        {
          categories.map((item) => (
            <a
              class="chip"
              href={withBase(`/category/${item.slug}/`)}
              aria-current={item.slug === category.slug ? 'page' : undefined}
            >
              {item.short}
            </a>
          ))
        }
      </div>
    </header>

    {
      posts.length > 0 ? (
        <div class="list" style="padding-bottom:64px">
          {posts.map((post, index) => (
            <a class="list-item" href={withBase(`/posts/${post.id}/`)}>
              <span class="list-item__media">
                <CoverTile
                  category={category}
                  index={String(index + 1).padStart(2, '0')}
                  variant="row"
                />
              </span>
              <div>
                <span class="chip chip--category">{category.short}</span>
                <h2 class="list-item__title">{post.data.title}</h2>
                <p class="list-item__desc">{post.data.description}</p>
                <p class="list-item__meta">
                  {formatDateShort(post.data.pubDate)}
                </p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="search-empty" style="padding-bottom:64px">
          아직 이 카테고리에 글이 없어요. 곧 채워 볼게요!
        </p>
      )
    }
  </div>
</BaseLayout>
