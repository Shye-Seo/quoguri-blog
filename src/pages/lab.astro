---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogCard from '../components/LogCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { site } from '../config';
import { absoluteUrl, withBase } from '../lib/site';
import { countByCategory, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const counts = await countByCategory();
const total = posts.length;
const logNo = (index: number) => String(total - index).padStart(3, '0');

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'))
  .slice(0, 12)
  .map(([tag, count]) => ({ tag, count }));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '쿼구리 전체 기록',
    url: absoluteUrl('/lab/'),
    description: `쿼구리 블로그의 모든 기록 ${total}편을 한곳에 모았습니다. 카테고리와 태그로 골라 볼 수 있어요.`,
    inLanguage: 'ko-KR',
    isPartOf: { '@type': 'WebSite', name: site.name, url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '전체 기록', item: absoluteUrl('/lab/') },
    ],
  },
];
---

<BaseLayout
  title="전체 기록"
  description={`쿼구리 블로그의 모든 기록 — 지금까지 ${total}편을 모았어요. 카테고리와 태그로 골라 볼 수 있습니다.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li aria-current="page">전체 기록</li>
      </ol>
    </nav>

    <header class="page-head">
      <p class="section-label">lab</p>
      <h1 class="page-head__title">전체 기록</h1>
      <p class="page-head__desc">
        리뷰부터 일상, 직접 만든 것까지 — 쿼구리가 남긴 기록을 한곳에 모았어요. 카테고리나 태그를 눌러 골라 보세요.
      </p>
    </header>

    <section aria-labelledby="all-records" style="padding-bottom:56px">
      <FilterBar counts={counts} total={total} tags={tags} inPlace />

      <p class="filter-note" data-filter-note>전체 <strong>{total}</strong>편</p>

      <div class="log-list" data-log-list>
        {
          posts.map((post, index) => (
            <LogCard post={post} logNo={logNo(index)} eager={index < 3} />
          ))
        }
      </div>

      <p class="search-empty" data-filter-empty hidden>
        이 조건에 맞는 기록이 아직 없어요. 다른 카테고리나 태그로 찾아보세요.
      </p>
    </section>
  </div>

  <script>
    import '../scripts/record-filter.js';
  </script>
</BaseLayout>
