---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="페이지를 찾을 수 없어요" description="주소가 바뀌었거나 글이 삭제됐어요." noindex>
  <div class="container" style="text-align:center; padding-block:72px 96px; max-width:620px">
    <BrandMark size={64} class="notfound__mark" />
    <p class="eyebrow" style="justify-content:center; margin-top:24px">404</p>
    <h1 class="page-head__title" style="margin-top:10px">여긴 아무것도 없어요</h1>
    <p class="page-head__desc" style="margin-inline:auto">
      주소가 바뀌었거나 글이 내려갔어요. 아래에서 다시 찾아보시겠어요?
    </p>
    <div class="hero__cta" style="justify-content:center">
      <a class="btn btn--primary" href={withBase('/')}>홈으로</a>
      <a class="btn" href={withBase('/search/')}>글 검색</a>
    </div>
  </div>
</BaseLayout>
