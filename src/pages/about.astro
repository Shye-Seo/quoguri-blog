---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { categories, coupang, site } from '../config';
import { absoluteUrl, withBase } from '../lib/site';

const faq = [
  {
    q: '쿼구리는 어떤 블로그인가요?',
    a: '테크·데스크테리어, 뷰티, 여행·디카, 일상 꿀팁을 직접 써보고 직접 찍은 것만 기록하는 리뷰 블로그입니다.',
  },
  {
    q: '협찬이나 광고 글이 올라오나요?',
    a: '광고비나 제품을 받고 쓰는 글은 글 맨 위에 먼저 밝힙니다. 좋지 않았던 점도 함께 적고, 평가에는 영향을 주지 않습니다.',
  },
  {
    q: '사진은 직접 찍나요?',
    a: '네. 본문 사진은 직접 찍은 사진을 씁니다. 사진이 없는 글은 카테고리 색과 제목으로 만든 타이포그래피 커버로 대신합니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `${site.name} 소개`,
    url: absoluteUrl('/about/'),
    description: site.description,
    inLanguage: 'ko-KR',
    mainEntity: {
      '@type': 'Organization',
      name: site.name,
      alternateName: site.nameEn,
      url: absoluteUrl('/'),
      description: site.description,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '쿼구리 소개', item: absoluteUrl('/about/') },
    ],
  },
];
---

<BaseLayout
  title="쿼구리 소개"
  description="쿼카처럼 웃고 너구리처럼 부스럭거리는 기록자, 쿼구리(quoguri)를 소개합니다. 직접 써보고 직접 찍은 것만 남기는 리뷰 블로그입니다."
  jsonLd={jsonLd}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li aria-current="page">쿼구리 소개</li>
      </ol>
    </nav>

    <header class="page-head">
      <p class="eyebrow">about</p>
      <h1 class="page-head__title">안녕하세요, 쿼구리예요</h1>
      <p class="page-head__desc">
        호주 쿼카처럼 해맑게 웃고, 너구리처럼 부스럭거리며 살림을 하는 기록자예요.
      </p>
    </header>

    <div class="page-prose">
      <div class="prose">
        <div class="about-plate">
          <BrandMark size={56} class="about-plate__mark" />
          <div>
            <p class="about-plate__name">쿼구리 <span>quoguri</span></p>
            <p class="about-plate__tag">{site.tagline}</p>
          </div>
        </div>

        <h2>쿼구리는 어떤 블로그예요?</h2>
        <p>
          이름은 <strong>쿼카</strong>와 <strong>구리</strong>를 붙여 만들었어요. 쿼카는 세상에서 제일 웃는 동물이고,
          구리는 제 별명이에요. 그래서 이 블로그의 규칙도 딱 두 가지예요. <strong>웃으면서 쓰기</strong>,
          그리고 <strong>직접 해본 것만 쓰기</strong>.
        </p>
        <p>
          책상 위 전자기기와 데스크테리어, 파우치 속 화장품, 빈티지 디카로 찍은 동네 풍경, 살림하다 발견한 작은 꿀팁까지
          카테고리만 다를 뿐 기록하는 태도는 같아요. 광고비를 받고 쓰는 글도 있지만, 안 좋았던 건 안 좋았다고 써요.
          그래야 다음에 검색해 들어온 분이 시간을 아끼니까요.
        </p>

        <h2>이런 걸 써요</h2>
        <ul>
          {
            categories.map((category) => (
              <li>
                <strong>{category.label}</strong> — {category.blurb}
              </li>
            ))
          }
        </ul>

        <h2>글을 쓰는 기준</h2>
        <ol>
          <li>제가 직접 사서, 직접 써보고, 직접 찍은 것만 올려요. 협찬을 받으면 글 맨 위에 먼저 밝혀요.</li>
          <li>좋았던 점만 늘어놓지 않아요. 아쉬웠던 점과 '이런 사람에게는 안 맞아요'까지 같이 적어요.</li>
          <li>가격·사양처럼 바뀔 수 있는 정보는 기준 날짜를 꼭 적어요.</li>
          <li>직접 확인하지 않은 소문이나 남의 후기는 옮겨 적지 않아요.</li>
        </ol>

        <h2>수익화 고지</h2>
        <p>
          이 블로그는 <strong>Google AdSense</strong> 광고와 <strong>쿠팡 파트너스</strong> 제휴 링크를 통해
          일정한 수익을 받을 수 있어요. 제휴 링크를 통해 구매하셔도 가격은 똑같고, 글의 내용이나 평가에는 영향을 주지 않아요.
        </p>
        <div class="callout callout--tip">
          <span class="callout__icon" aria-hidden="true">i</span>
          <span>{coupang.disclosure}</span>
        </div>

        <h2>자주 묻는 것</h2>
        <dl class="faq">
          {
            faq.map((item) => (
              <div class="faq__item">
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))
          }
        </dl>

        <h2>함께 이야기해요</h2>
        <p>
          리뷰 요청, 협업 제안, 오류 제보는 언제든 환영이에요. 글에 대한 정정 요청은 확인하는 대로 반영하고,
          수정한 날짜를 글 상단에 남겨요.
        </p>
        {
          site.contactEmail ? (
            <p>
              <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
            </p>
          ) : (
            <p>
              <a href={withBase('/search/')}>블로그 글 검색하기</a> · <a href={withBase('/privacy/')}>개인정보처리방침</a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
