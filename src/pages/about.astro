---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, coupang, site } from '../config';
import { absoluteUrl, asset, withBase } from '../lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `${site.name} 소개`,
  url: absoluteUrl('/about/'),
  description: site.description,
};
---

<BaseLayout title="쿼구리 소개" description="쿼카처럼 웃고 너구리처럼 부스럭거리는 기록자, 쿼구리(quoguri)를 소개합니다." jsonLd={jsonLd}>
  <div class="container">
    <header class="page-head" style="border-bottom:none; margin-bottom:8px">
      <p class="eyebrow">about</p>
      <h1 class="page-head__title">안녕하세요, 쿼구리예요 🐾</h1>
      <p class="page-head__desc">
        호주 쿼카처럼 해맑게 웃고, 너구리처럼 부스럭거리며 살림을 하는 기록자예요.
      </p>
    </header>

    <div class="page-prose">
      <div class="prose">
        <figure>
          <img src={asset('/images/hero-quokka.jpg')} alt="카메라를 든 쿼카 쿼구리 일러스트" width="1200" height="1064" loading="lazy" />
          <figcaption>쿼구리 — quokka + 구리</figcaption>
        </figure>

        <h2>쿼구리는 어떤 블로그예요?</h2>
        <p>
          이름은 <strong>쿼카</strong>와 <strong>구리</strong>를 붙여 만들었어요. 쿼카는 세상에서 제일 웃는 동물이고,
          구리는 제 별명이에요. 그래서 이 블로그의 규칙도 딱 두 가지예요. <strong>웃으면서 쓰기</strong>,
          그리고 <strong>직접 해본 것만 쓰기</strong>.
        </p>
        <p>
          책상 위 전자기기와 데스크테리어, 파우치 속 화장품, 빈티지 디카로 찍은 동네 풍경, 살림하다 발견한 작은 꿀팁까지
          카테고리만 다를 뿐 기록하는 태도는 같아요. 광고비를 받고 쓰는 글도 있지만, 안 좋았던 건 안 좋았다고 써요.
          그래야 다음에 검색해 들어온 분이 시간을 아끼니까요.
        </p>

        <h2>이런 걸 써요</h2>
        <ul>
          {
            categories.map((category) => (
              <li>
                <strong>{category.label}</strong> — {category.blurb}
              </li>
            ))
          }
        </ul>

        <h2>글을 쓰는 기준</h2>
        <ol>
          <li>제가 직접 사서, 직접 써보고, 직접 찍은 것만 올려요. 협찬을 받으면 글 맨 위에 먼저 밝혀요.</li>
          <li>좋았던 점만 늘어놓지 않아요. 아쉬웠던 점과 '이런 사람에게는 안 맞아요'까지 같이 적어요.</li>
          <li>가격·사양처럼 바뀔 수 있는 정보는 기준 날짜를 꼭 적어요.</li>
          <li>직접 확인하지 않은 소문이나 남의 후기는 옮겨 적지 않아요.</li>
        </ol>

        <h2>수익화 고지</h2>
        <p>
          이 블로그는 <strong>Google AdSense</strong> 광고와 <strong>쿠팡 파트너스</strong> 제휴 링크를 통해
          일정한 수익을 받을 수 있어요. 제휴 링크를 통해 구매하셔도 가격은 똑같고, 글의 내용이나 평가에는 영향을 주지 않아요.
        </p>
        <div class="callout callout--tip">
          <span class="callout__icon" aria-hidden="true">💡</span>
          <span>{coupang.disclosure}</span>
        </div>

        <h2>함께 이야기해요</h2>
        <p>
          리뷰 요청, 협업 제안, 오류 제보는 언제든 환영이에요. 글에 대한 정정 요청은 확인하는 대로 반영하고,
          수정한 날짜를 글 상단에 남겨요.
        </p>
        {
          site.contactEmail ? (
            <p>
              <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
            </p>
          ) : (
            <p>
              <a href={withBase('/search/')}>블로그 글 검색하기</a> · <a href={withBase('/privacy/')}>개인정보처리방침</a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
