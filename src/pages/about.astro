---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, coupang, site } from '../config';
import { absoluteUrl, withBase } from '../lib/site';
import about from '../content/pages/about.json';

const faq = about.faq.items.filter((item) => item.q.trim() && item.a.trim());
const description = about.meta.description || site.description;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: about.meta.title,
    url: absoluteUrl('/about/'),
    description,
    inLanguage: 'ko-KR',
    mainEntity: {
      '@type': 'Organization',
      name: site.name,
      alternateName: site.nameEn,
      url: absoluteUrl('/'),
      description,
    },
  },
  ...(faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: about.meta.title, item: absoluteUrl('/about/') },
    ],
  },
];
---

<BaseLayout title={about.meta.title} description={description} jsonLd={jsonLd}>
  <div class="container about-page">
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li aria-current="page">{about.meta.title}</li>
      </ol>
    </nav>

    <header class="page-head">
      <p class="eyebrow">{about.meta.eyebrow}</p>
      <h1 class="page-head__title">{about.hero.title}</h1>
      <p class="page-head__desc">{about.hero.lede}</p>
    </header>

    <div class="page-prose">
      <div class="prose">
        <div class="about-plate">
          <p class="about-plate__name">
            {about.plate.name} <span>{about.plate.nameEn}</span>
          </p>
          <p class="about-plate__tag">{about.plate.tagline || site.tagline}</p>
        </div>

        {
          about.intro.heading && (
            <>
              <h2>{about.intro.heading}</h2>
              {about.intro.paragraphs
                .filter((paragraph) => paragraph.trim())
                .map((paragraph) => <p>{paragraph}</p>)}
            </>
          )
        }

        {
          about.topics.heading && (
            <>
              <h2>{about.topics.heading}</h2>
              <ul>
                {categories.map((category) => (
                  <li>
                    <strong>{category.label}</strong> — {category.blurb}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          about.rules.heading && about.rules.items.length > 0 && (
            <>
              <h2>{about.rules.heading}</h2>
              <ol>
                {about.rules.items
                  .filter((item) => item.trim())
                  .map((item) => <li>{item}</li>)}
              </ol>
            </>
          )
        }

        {
          about.monetization.heading && (
            <>
              <h2>{about.monetization.heading}</h2>
              {about.monetization.paragraph && <p>{about.monetization.paragraph}</p>}
              <div class="callout callout--tip">
                <span class="callout__icon" aria-hidden="true">i</span>
                <span>{coupang.disclosure}</span>
              </div>
            </>
          )
        }

        {
          faq.length > 0 && (
            <>
              <h2>{about.faq.heading}</h2>
              <dl class="faq">
                {faq.map((item) => (
                  <div class="faq__item">
                    <dt>{item.q}</dt>
                    <dd>{item.a}</dd>
                  </div>
                ))}
              </dl>
            </>
          )
        }

        {
          about.contact.heading && (
            <>
              <h2>{about.contact.heading}</h2>
              {about.contact.paragraph && <p>{about.contact.paragraph}</p>}
              {site.contactEmail ? (
                <p>
                  <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
                </p>
              ) : (
                <p>
                  <a href={withBase('/search/')}>블로그 글 검색하기</a> ·{' '}
                  <a href={withBase('/privacy/')}>개인정보처리방침</a>
                </p>
              )}
            </>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
