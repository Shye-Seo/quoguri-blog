---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { site } from '../../config';
import { absoluteUrl, asset, formatDate, readingTime, withBase } from '../../lib/site';
import {
  categoryOf,
  getAdjacentPosts,
  getPublishedPosts,
  getRelatedPosts,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);

const category = categoryOf(post);
const related = await getRelatedPosts(post, 3);
const { newer, older } = await getAdjacentPosts(post);
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = readingTime(post.body ?? '');
const updated = post.data.updatedDate;

const canonical = absoluteUrl(`/posts/${post.id}/`);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: [absoluteUrl(post.data.cover)],
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (updated ?? post.data.pubDate).toISOString(),
    author: { '@type': 'Person', name: site.author.name },
    publisher: { '@type': 'Organization', name: site.name },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    articleSection: category.label,
    keywords: post.data.tags.join(', '),
    inLanguage: 'ko-KR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: category.label, item: absoluteUrl(`/category/${category.slug}/`) },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={updated}
  jsonLd={jsonLd}
>
  <article class="container">
    <header class="post-header">
      <a class="chip chip--category" href={withBase(`/category/${category.slug}/`)}>
        {category.emoji} {category.label}
      </a>
      <h1 class="post-header__title">{post.data.title}</h1>
      <p class="post-header__desc">{post.data.description}</p>
      <div class="post-meta">
        <span>{site.author.name}</span>
        <time datetime={post.data.pubDate.toISOString()} class="post-meta__dot">{formatDate(post.data.pubDate)}</time>
        <span class="post-meta__dot">{minutes}분 읽기</span>
        {updated && <span class="post-meta__dot">{formatDate(updated)} 수정</span>}
      </div>
    </header>

    <figure class="post-cover">
      <img
        src={asset(post.data.cover)}
        alt={post.data.coverAlt ?? `${post.data.title} 대표 이미지`}
        width="1600"
        height="1000"
        loading="eager"
      />
    </figure>

    <div class="post-body-wrap">
      <div class="post-main">
        <div class="prose">
          <Content />
        </div>

        <AdSlot />

        <footer class="post-footer">
          {
            post.data.tags.length > 0 && (
              <div class="chip-row">
                {post.data.tags.map((tag) => (
                  <a class="chip" href={withBase(`/search/?q=${encodeURIComponent(tag)}`)}>
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }

          <div class="post-footer__row">
            <div class="author-box">
              <img src={asset('/images/quokka-avatar.jpg')} alt="" width="46" height="46" loading="lazy" />
              <div>
                <p class="author-box__name">{site.author.name} · {site.author.role}</p>
                <p class="author-box__text">직접 써보고 직접 찍은 것만 기록해요. {site.nameEn} 블로그에서 만나요.</p>
              </div>
            </div>
            <div class="share">
              <span>공유</span>
              <button type="button" id="copy-link">링크 복사</button>
              <button type="button" id="native-share" hidden>공유하기</button>
            </div>
          </div>

          {
            (newer || older) && (
              <nav class="post-nav" aria-label="이전·다음 글">
                {older ? (
                  <a class="post-nav__item" href={withBase(`/posts/${older.id}/`)}>
                    <span class="post-nav__label">이전 글</span>
                    <span class="post-nav__title">{older.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {newer && (
                  <a class="post-nav__item post-nav__item--next" href={withBase(`/posts/${newer.id}/`)}>
                    <span class="post-nav__label">다음 글</span>
                    <span class="post-nav__title">{newer.data.title}</span>
                  </a>
                )}
              </nav>
            )
          }
        </footer>
      </div>

      {
        tocItems.length > 1 && (
          <aside class="toc" aria-label="목차">
            <p class="toc__title">목차</p>
            <ol>
              {tocItems.map((heading) => (
                <li class={heading.depth === 3 ? 'toc__sub' : undefined}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="container" style="padding-bottom: 64px;">
        <div class="section-head">
          <div>
            <p class="eyebrow">next</p>
            <h2>이 글과 함께 읽으면 좋은 글</h2>
          </div>
          <a class="text-link" href={withBase(`/category/${category.slug}/`)}>{category.label} 전체 보기 →</a>
        </div>
        <div class="post-grid">
          {related.map((item) => (
            <PostCard post={item} />
          ))}
        </div>
      </section>
    )
  }

  <script>
    const copyButton = document.getElementById('copy-link') as HTMLButtonElement | null;
    copyButton?.addEventListener('click', async () => {
      const original = copyButton.textContent;
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyButton.textContent = '복사했어요!';
      } catch {
        copyButton.textContent = '주소창에서 복사해 주세요';
      }
      window.setTimeout(() => {
        copyButton.textContent = original ?? '링크 복사';
      }, 1800);
    });

    const shareButton = document.getElementById('native-share') as HTMLButtonElement | null;
    if (shareButton && typeof navigator.share === 'function') {
      shareButton.hidden = false;
      shareButton.addEventListener('click', () => {
        navigator.share({ title: document.title, url: window.location.href }).catch(() => {});
      });
    }
  </script>
</BaseLayout>
