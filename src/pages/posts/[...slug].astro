---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import BrandMark from '../../components/BrandMark.astro';
import { features, coupang, site } from '../../config';
import { absoluteUrl, asset, formatDate, readingTime, withBase } from '../../lib/site';
import { coupangNoticeHtml, needsCoupangDisclosure } from '../../lib/disclosure.js';
import {
  categoryOf,
  getAdjacentPosts,
  getPublishedPosts,
  getRelatedPosts,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);

const allPosts = await getPublishedPosts();
const indexNo = String(allPosts.findIndex((item) => item.id === post.id) + 1).padStart(2, '0');
const category = categoryOf(post);
const related = await getRelatedPosts(post, features.relatedCount);
const { newer, older } = await getAdjacentPosts(post);
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = readingTime(post.body ?? '');
const updated = post.data.updatedDate;

/** 쿠팡 파트너스 글은 본문이 시작되기 전에 공시 배너를 먼저 보여 줍니다. */
const showCoupangNotice = needsCoupangDisclosure({ coupang: post.data.coupang, body: post.body });

const canonical = absoluteUrl(`/posts/${post.id}/`);
const title = post.data.seoTitle ?? post.data.title;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: post.data.description,
    image: [absoluteUrl(post.data.cover ?? site.ogImage)],
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (updated ?? post.data.pubDate).toISOString(),
    author: { '@type': 'Person', name: site.author.name, url: absoluteUrl('/about/') },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: absoluteUrl('/'),
      logo: {
        '@type': 'ImageObject',
        url: absoluteUrl(site.ogImage),
        width: 1200,
        height: 630,
      },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    articleSection: category.label,
    keywords: post.data.tags.join(', '),
    wordCount: (post.body ?? '').replace(/\s+/g, ' ').trim().split(' ').length,
    inLanguage: 'ko-KR',
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: category.label, item: absoluteUrl(`/category/${category.slug}/`) },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={post.data.description}
  image={post.data.cover ?? site.ogImage}
  imageAlt={post.data.coverAlt ?? `${post.data.title} — ${site.name} 글`}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={updated}
  keywords={post.data.tags}
  articleSection={category.label}
  articleTags={post.data.tags}
  jsonLd={jsonLd}
>
  {
    features.readingProgress && (
      <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
    )
  }

  <article class="container" style={`--accent:${category.accent}`}>
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li><a href={withBase(`/category/${category.slug}/`)}>{category.label}</a></li>
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <header class="post-header">
      <div class="post-header__kicker">
        <span class="post-header__no" aria-hidden="true">{indexNo}</span>
        <a class="chip chip--category" href={withBase(`/category/${category.slug}/`)}>
          {category.label}
        </a>
      </div>
      <h1 class="post-header__title">{post.data.title}</h1>
      <p class="post-header__desc">{post.data.description}</p>
      <div class="post-meta">
        <span>{site.author.name}</span>
        <time datetime={post.data.pubDate.toISOString()} class="post-meta__dot">{formatDate(post.data.pubDate)}</time>
        <span class="post-meta__dot">{minutes}분 읽기</span>
        {updated && <span class="post-meta__dot">{formatDate(updated)} 수정</span>}
      </div>
      {post.data.series && <p class="post-header__series">시리즈 · {post.data.series}</p>}
    </header>

    {
      post.data.cover && (
        <figure class="post-cover">
          <img
            src={asset(post.data.cover)}
            alt={post.data.coverAlt ?? `${post.data.title} 대표 이미지`}
            width="1600"
            height="1000"
            loading="eager"
          />
          {post.data.coverAlt && <figcaption>{post.data.coverAlt}</figcaption>}
        </figure>
      )
    }

    <div class="post-body-wrap">
      <div class="post-main">
        {showCoupangNotice && <div set:html={coupangNoticeHtml(coupang.disclosure)} />}
        <div class="prose">
          <Content />
        </div>

        <AdSlot />

        <footer class="post-footer">
          {
            post.data.tags.length > 0 && (
              <div class="chip-row" aria-label="태그">
                {post.data.tags.map((tag) => (
                  <a class="chip" href={withBase(`/search/?q=${encodeURIComponent(tag)}`)}>
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }

          <div class="post-footer__row">
            <div class="author-box">
              <BrandMark size={44} class="author-box__mark" />
              <div>
                <p class="author-box__name">{site.author.name} · {site.author.role}</p>
                <p class="author-box__text">직접 써보고 직접 검증한 것만 기록해요. {site.nameEn} 블로그에서 만나요.</p>
              </div>
            </div>
            <div class="share">
              <span>공유</span>
              <button type="button" id="copy-link">링크 복사</button>
              <button type="button" id="native-share" hidden>공유하기</button>
            </div>
          </div>

          {
            (newer || older) && (
              <nav class="post-nav" aria-label="이전·다음 글">
                {older ? (
                  <a class="post-nav__item" href={withBase(`/posts/${older.id}/`)}>
                    <span class="post-nav__label">이전 글</span>
                    <span class="post-nav__title">{older.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
                {newer && (
                  <a class="post-nav__item post-nav__item--next" href={withBase(`/posts/${newer.id}/`)}>
                    <span class="post-nav__label">다음 글</span>
                    <span class="post-nav__title">{newer.data.title}</span>
                  </a>
                )}
              </nav>
            )
          }
        </footer>
      </div>

      {
        tocItems.length > 1 && (
          <aside class="toc" aria-label="목차">
            <p class="toc__title">목차</p>
            <ol>
              {tocItems.map((heading) => (
                <li class={heading.depth === 3 ? 'toc__sub' : undefined}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="container section section--tight">
        <div class="section-head">
          <div>
            <p class="eyebrow">next</p>
            <h2>이 글과 함께 읽으면 좋은 글</h2>
          </div>
          <a class="text-link" href={withBase(`/category/${category.slug}/`)}>{category.label} 전체 보기 →</a>
        </div>
        <div class="post-grid">
          {related.map((item, index) => (
            <PostCard post={item} index={String(index + 1).padStart(2, '0')} />
          ))}
        </div>
      </section>
    )
  }

  <script>
    const copyButton = document.getElementById('copy-link') as HTMLButtonElement | null;
    copyButton?.addEventListener('click', async () => {
      const original = copyButton.textContent;
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyButton.textContent = '복사했어요!';
      } catch {
        copyButton.textContent = '주소창에서 복사해 주세요';
      }
      window.setTimeout(() => {
        copyButton.textContent = original ?? '링크 복사';
      }, 1800);
    });

    const shareButton = document.getElementById('native-share') as HTMLButtonElement | null;
    if (shareButton && typeof navigator.share === 'function') {
      shareButton.hidden = false;
      shareButton.addEventListener('click', () => {
        navigator.share({ title: document.title, url: window.location.href }).catch(() => {});
      });
    }

    const progressBar = document.getElementById('reading-progress-bar');
    if (progressBar) {
      const update = () => {
        const article = document.querySelector('article');
        if (!article) return;
        const rect = article.getBoundingClientRect();
        const total = article.offsetHeight - window.innerHeight;
        const passed = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        progressBar.style.transform = `scaleX(${total > 0 ? passed / total : 0})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }
  </script>
</BaseLayout>
