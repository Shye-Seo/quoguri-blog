---
import BaseLayout from '../layouts/BaseLayout.astro';
import { analytics, coupang, site } from '../config';
import { absoluteUrl, formatDate, withBase } from '../lib/site';

const updated = new Date('2026-11-21');
const description =
  '쿼구리 블로그의 개인정보처리방침 — 쿠키, 방문 분석(Google Analytics 4), 광고(Google AdSense), 제휴 링크(쿠팡 파트너스) 안내.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '쿼구리 개인정보처리방침',
    url: absoluteUrl('/privacy/'),
    description,
    inLanguage: 'ko-KR',
    dateModified: updated.toISOString(),
    isPartOf: { '@type': 'WebSite', name: site.name, url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '개인정보처리방침', item: absoluteUrl('/privacy/') },
    ],
  },
];
---

<BaseLayout
  title="개인정보처리방침"
  description={description}
  jsonLd={jsonLd}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li aria-current="page">개인정보처리방침</li>
      </ol>
    </nav>

    <header class="page-head">
      <p class="eyebrow">privacy</p>
      <h1 class="page-head__title">개인정보처리방침</h1>
      <p class="page-head__desc">시행일 {formatDate(updated)} · 이 블로그는 방문자의 개인정보를 최소한으로만 다뤄요.</p>
    </header>

    <div class="page-prose">
      <div class="prose">
        <h2>1. 수집하는 정보</h2>
        <p>
          {site.name} 블로그는 회원가입 기능이 없고, 이름·전화번호 같은 개인정보를 직접 입력받지 않아요.
          다만 서비스 운영 과정에서 아래 정보가 자동으로 수집될 수 있어요.
        </p>
        <ul>
          <li>접속 기록(IP 주소, 브라우저·기기 정보, 방문 일시, 방문 페이지)</li>
          <li>쿠키 및 이와 유사한 기술로 생성되는 이용 기록</li>
          <li>방문 통계 도구(Google Analytics 4)가 수집하는 페이지 조회·유입 경로·체류 시간 같은 이용 기록</li>
        </ul>

        <h2>2. 이용 목적</h2>
        <ul>
          <li>블로그 방문 통계 확인과 콘텐츠 개선</li>
          <li>광고 게재 및 부정 클릭 방지</li>
          <li>오류 확인과 보안 유지</li>
        </ul>

        <h2>3. 쿠키(Cookie)란</h2>
        <p>
          쿠키는 웹사이트를 방문할 때 브라우저에 저장되는 작은 기록 파일이에요. 이 블로그는
          테마(밝게·어둡게) 같은 화면 설정을 기억하고, 방문 통계와 광고를 위해 아래 사업자의 쿠키를 사용해요.
          쿠키는 브라우저 설정에서 언제든 삭제하거나 저장을 거부할 수 있어요. 다만 거부하면 일부 기능이나
          화면 설정이 유지되지 않을 수 있어요.
        </p>
        <p>
          이 블로그가 사용하는 쿠키는 다음과 같아요.
        </p>
        <ul>
          <li><strong>화면 설정 쿠키</strong> — 다크·라이트 테마 선택을 기억합니다. (이 블로그가 직접 저장)</li>
          <li><strong>Google Analytics 4 쿠키</strong> — 방문자 수·유입 경로·조회한 글을 통계로 모읍니다.</li>
          <li><strong>Google AdSense 쿠키</strong> — 광고 게재와 부정 클릭 방지, 관심사 기반 광고에 쓰입니다.</li>
          <li><strong>쿠팡 파트너스 쿠키</strong> — 제휴 링크를 통한 방문·구매가 집계되도록 쓰입니다.</li>
        </ul>

        <h2>4. 방문 분석 — Google Analytics 4</h2>
        <p>
          이 블로그는 방문 통계를 위해 <strong>Google Analytics 4(GA4)</strong>를 사용해요. GA4는 쿠키와 익명화된
          식별자를 이용해 방문 페이지, 유입 경로, 대략적인 지역(국가·도시 수준), 기기·브라우저 정보, 체류 시간을
          수집합니다. 이 기록은 어떤 글이 도움이 되는지 확인하고 글을 고치는 데만 쓰며, 방문자를 개인적으로
          식별하거나 다른 정보와 결합해 사용하지 않아요.
        </p>
        <p>
          GA4의 수집을 원하지 않으면{' '}
          <a href="https://tools.google.com/dlpage/gaoptout?hl=ko" rel="nofollow noopener" target="_blank">
            Google Analytics 차단 브라우저 추가 기능
          </a>
          을 설치하거나 브라우저에서 쿠키를 차단할 수 있어요. 자세한 내용은{' '}
          <a href="https://policies.google.com/privacy?hl=ko" rel="nofollow noopener" target="_blank">Google 개인정보처리방침</a>
          에서 확인할 수 있어요.
        </p>
        {!analytics.enabled && (
          <p>
            <em>참고: 이 블로그는 현재 GA4 측정 ID가 설정되지 않아 방문 분석을 켜지 않은 상태예요. 설정하면 이 방침의 내용이 그대로 적용됩니다.</em>
          </p>
        )}

        <h2>5. 광고 — Google AdSense</h2>
        <p>
          이 블로그는 <strong>Google AdSense</strong>를 통해 광고를 게재할 수 있어요. Google을 포함한 제3자 광고
          사업자는 쿠키를 사용해 방문자가 이 사이트나 다른 사이트를 방문한 기록을 바탕으로 광고를 표시할 수 있어요.
          이 과정에서 광고 사업자가 IP 주소, 기기·브라우저 정보, 광고 노출·클릭 기록을 수집할 수 있으며,
          이 블로그는 그 개별 기록을 제공받지 않아요.
        </p>
        <p>
          Google의 광고 쿠키 사용에 대한 자세한 내용과 거부 방법은{' '}
          {' '}<a href="https://policies.google.com/technologies/ads?hl=ko" rel="nofollow noopener" target="_blank">Google 광고 정책 안내</a>에서 확인할 수 있어요.
        </p>
        <p>
          광고 쿠키는 <a href="https://adssettings.google.com/" rel="nofollow noopener" target="_blank">Google 광고 설정</a>에서
          끌 수 있고, 브라우저 설정에서 쿠키 저장을 거부할 수도 있어요. 다만 쿠키를 거부하면 일부 기능 이용이 제한될 수 있어요.
        </p>

        <h2>6. 제휴 링크 — 쿠팡 파트너스</h2>
        <p>{coupang.disclosure}</p>
        <p>
          쿠팡 파트너스 링크가 들어간 글은 본문 맨 위에 이 사실을 먼저 알려요. 링크를 통해 쿠팡에서 상품을
          구매하면 쿠팡 파트너스 쿠키를 기준으로 구매가 집계되고, 이 블로그는 그에 따른 일정액의 수수료를
          받을 수 있어요. 구매 가격은 링크를 쓰지 않았을 때와 같으며, 수수료는 글의 평가나 순서에 영향을 주지 않아요.
        </p>
        <p>
          제휴 링크를 통한 구매 여부는 쿠팡 파트너스에서 집계되며, 이 블로그는 구매자의 이름·주소·결제 정보 같은
          개별 정보를 제공받지 않아요. 쿠팡의 개인정보 처리에 대한 내용은{' '}
          <a href="https://www.coupang.com/np/policies/privacy" rel="nofollow noopener" target="_blank">쿠팡 개인정보처리방침</a>
          에서 확인할 수 있어요.
        </p>

        <h2>7. 보관과 파기</h2>
        <p>
          자동 수집된 접속 기록은 목적 달성에 필요한 기간 동안만 보관하고, 기간이 지나면 지체 없이 파기해요.
          별도로 보관이 필요한 경우에는 항목과 기간을 정해 안내해요. Google Analytics의 수집 데이터는 Google의
          보관 정책에 따라 처리돼요.
        </p>

        <h2>8. 제3자 제공</h2>
        <p>
          방문자의 개인정보를 제3자에게 판매하거나 제공하지 않아요. 다만 위에 적은 Google(분석·광고), 쿠팡 파트너스(제휴 집계)처럼
          서비스 제공에 필요한 범위에서 각 사업자의 정책에 따라 처리되며, 법령에 따라 요청이 있는 경우에는 예외로 해요.
        </p>

        <h2>9. 문의</h2>
        <p>
          개인정보 관련 문의는 {site.contactEmail ? <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> : '블로그 운영자'}에게 알려 주세요.
          확인하는 대로 빠르게 답변드릴게요.
        </p>

        <h2>10. 고지 의무</h2>
        <p>
          이 방침의 내용이 바뀌면 블로그에 공지하고, 시행일을 갱신해요.
          <a href={withBase('/about/')}>쿼구리 소개</a> 페이지에서 운영 원칙도 함께 확인할 수 있어요.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
