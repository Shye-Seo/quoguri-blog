---
/**
 * 쿼구리 관리자 (/admin/)
 *
 * · 검색엔진·사이트맵·네비게이션에서 완전히 분리되어 있습니다.
 * · 이 파일에는 계정 정보가 하나도 없습니다. 로그인은 방문자가 직접 발급한
 *   GitHub 토큰으로만 이뤄지고, 토큰은 브라우저 저장소에만 남습니다.
 */
import '../../styles/admin.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>쿼구리 관리자</title>
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110d" media="(prefers-color-scheme: dark)" />
    <!--
      이 화면은 GitHub API(api.github.com) 외에는 어떤 곳과도 통신하지 않습니다.
      아래 정책은 그 사실을 브라우저에 강제하는 안전장치입니다.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://api.github.com; font-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <div id="admin-root" data-base={base}>
      <noscript>
        <div class="noscript">
          <strong>자바스크립트가 필요해요.</strong><br />
          브라우저 설정에서 이 사이트의 자바스크립트를 허용한 뒤 다시 열어 주세요.
        </div>
      </noscript>
    </div>

    <script>
      import { initAdmin } from '../../admin/main.js';
      initAdmin();
    </script>
  </body>
</html>
