---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import BrandMark from '../components/BrandMark.astro';
import CoverTile from '../components/CoverTile.astro';
import { categories, features, site } from '../config';
import { absoluteUrl, formatDate, readingTime, withBase } from '../lib/site';
import { categoryOf, countByCategory, getFeaturedPost, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const featured = await getFeaturedPost();
const counts = await countByCategory();
const recent = featured
  ? posts.filter((post) => post.id !== featured.id).slice(0, features.recentCount)
  : posts.slice(0, features.recentCount);
const featuredCategory = featured ? categoryOf(featured) : undefined;
const latest = posts.slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: site.nameEn,
    url: absoluteUrl('/'),
    description: site.description,
    inLanguage: 'ko-KR',
    publisher: { '@type': 'Organization', name: site.name, url: absoluteUrl('/') },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${absoluteUrl('/search/')}?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    alternateName: site.nameEn,
    url: absoluteUrl('/'),
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl(site.ogImage),
      width: 1200,
      height: 630,
    },
    description: site.description,
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <div class="hero__main">
        <p class="eyebrow">{site.nameEn} · {site.name}</p>
        <h1 class="hero__title">
          오늘 써본 것들을,<br />
          <em>귀엽고 솔직하게.</em>
        </h1>
        <p class="hero__lede">
          책상 위 전자기기부터 파우치 속 화장품, 빈티지 디카로 찍은 동네 풍경까지.
          직접 써보고 직접 찍은 것만 기록하는 공간이에요.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={withBase('/categories/')}>글 전체 보기</a>
          <a class="btn" href={withBase('/about/')}>쿼구리 소개</a>
        </div>
        <div class="hero__meta">
          <span>직접 써본 것만</span>
          <span>직접 찍은 사진만</span>
          <span>{posts.length}편의 기록</span>
        </div>
      </div>

      <aside class="hero__index" aria-label="최근에 올린 글">
        <p class="hero__index-title">지금 읽을 수 있는 글</p>
        <ol class="hero__index-list">
          {
            latest.map((post, index) => {
              const category = categoryOf(post);
              return (
                <li>
                  <a href={withBase(`/posts/${post.id}/`)}>
                    <span class="hero__index-no">{String(index + 1).padStart(2, '0')}</span>
                    <span class="hero__index-text">
                      <span class="hero__index-cat">{category.short}</span>
                      <span class="hero__index-title-text">{post.data.title}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ol>
        <a class="hero__index-more" href={withBase('/categories/')}>전체 글 보기 →</a>
      </aside>
    </section>

    <section aria-labelledby="categories-title" class="section section--tight">
      <h2 id="categories-title" class="sr-only">카테고리</h2>
      <div class="category-strip">
        {
          categories.map((category) => (
            <a class="category-card" href={withBase(`/category/${category.slug}/`)} style={`--accent:${category.accent}`}>
              <span class="category-card__top">
                <span class="category-card__emoji" aria-hidden="true">{category.emoji}</span>
                <span class="category-card__count">{counts[category.slug]}편</span>
              </span>
              <span class="category-card__label">{category.label}</span>
              <span class="category-card__blurb">{category.blurb}</span>
              <span class="category-card__arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </section>

    {
      featured && featuredCategory && (
        <section aria-labelledby="featured-title" class="section section--tight">
          <div class="section-head">
            <div>
              <p class="eyebrow">pick</p>
              <h2 id="featured-title">쿼구리가 고른 이번 주 글</h2>
            </div>
            <a class="text-link" href={withBase('/categories/')}>전체 글 보기 →</a>
          </div>
          <article class="featured" style={`--accent:${featuredCategory.accent}`}>
            <div class="featured__media">
              <CoverTile category={featuredCategory} index="01" variant="hero" />
            </div>
            <div class="featured__body">
              <a class="chip chip--category" href={withBase(`/category/${featuredCategory.slug}/`)}>
                {featuredCategory.label}
              </a>
              <h3 class="featured__title">
                <a href={withBase(`/posts/${featured.id}/`)}>{featured.data.title}</a>
              </h3>
              <p class="featured__desc">{featured.data.description}</p>
              <div class="post-meta post-meta--start">
                <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
                <span class="post-meta__dot">{readingTime(featured.body ?? '')}분 읽기</span>
              </div>
              <a class="featured__more" href={withBase(`/posts/${featured.id}/`)}>글 읽으러 가기 →</a>
            </div>
          </article>
        </section>
      )
    }

    <section aria-labelledby="recent-title" class="section section--tight">
      <div class="section-head">
        <div>
          <p class="eyebrow">recent</p>
          <h2 id="recent-title">최근에 올린 글</h2>
        </div>
        <p class="section-head__note">한 주에 한 편씩, 꾸준히 쌓는 중이에요</p>
      </div>

      {
        recent.length > 0 ? (
          <div class="post-grid">
            {recent.map((post, index) => (
              <PostCard post={post} index={String(index + 2).padStart(2, '0')} />
            ))}
          </div>
        ) : (
          <p class="search-empty">아직 올린 글이 없어요. 곧 첫 글로 만나요!</p>
        )
      }
    </section>

    <AdSlot slot="home" />

    <section class="section section--tight">
      <div class="author-box">
        <BrandMark size={44} class="author-box__mark" />
        <div>
          <p class="author-box__name">{site.name} ({site.nameEn})</p>
          <p class="author-box__text">
            호주 쿼카처럼 웃고, 너구리처럼 부스럭거리며 기록해요. 테크·데스크테리어, 뷰티, 여행·디카, 일상 꿀팁까지
            직접 써보고 남는 것만 남겨요.
            <a class="text-link" href={withBase('/about/')}>더 보기 →</a>
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
