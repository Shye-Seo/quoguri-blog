---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/game.css';
import { absoluteUrl, withBase } from '../../lib/site';

const title = '쿼구리 키우기';
const description =
  '다마고치 기기 속 쿼구리를 키우는 웹 게임. 밥주기·놀아주기·재우기·쓰다듬기로 배부름·기분·기운을 채워 주세요. 로그인 없이 바로 플레이.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: title,
    url: absoluteUrl('/game/quoguri-pet/'),
    description,
    genre: ['육성', '캐주얼'],
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    inLanguage: 'ko-KR',
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: '쿼구리', url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '게임', item: absoluteUrl('/game/') },
      { '@type': 'ListItem', position: 3, name: title, item: absoluteUrl('/game/quoguri-pet/') },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container game-page">
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li><a href={withBase('/game/')}>게임</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="game-head">
      <p class="section-label">game · 다마고치</p>
      <h1 class="game-head__title">🐾 쿼구리 키우기</h1>
      <p class="game-head__desc">
        기기 속 쿼구리는 시간이 지나면 배가 고프고, 심심하고, 졸려해요. 네 가지 돌보기로 기분을 맞춰 주세요.
      </p>
    </header>

    <section class="pet-stage" aria-label="쿼구리 키우기 게임">
      <div class="pet-device" data-pet-device>
        <span class="pet-device__ring" aria-hidden="true"></span>
        <div class="pet-device__shell">
          <div class="pet-screen">
            <span class="pet-bubble" data-pet-bubble aria-live="polite">안녕! 만나서 반가워</span>

            <div class="pet-actor" data-pet-actor>
              <svg class="pet-figure" data-mood="happy" viewBox="0 0 200 170" role="img" aria-label="쿼구리 캐릭터">
                <g class="pet-body">
                  <circle class="pet-ear" cx="54" cy="46" r="17" />
                  <circle class="pet-ear" cx="146" cy="46" r="17" />
                  <circle class="pet-ear-in" cx="54" cy="46" r="8.5" />
                  <circle class="pet-ear-in" cx="146" cy="46" r="8.5" />
                  <ellipse class="pet-head" cx="100" cy="96" rx="63" ry="55" />
                  <ellipse class="pet-paw" cx="38" cy="124" rx="14" ry="11" />
                  <ellipse class="pet-paw" cx="162" cy="124" rx="14" ry="11" />
                  <circle class="pet-cheek" cx="70" cy="104" r="10" />
                  <circle class="pet-cheek" cx="130" cy="104" r="10" />
                </g>

                <g class="eyes eyes--open">
                  <ellipse cx="80" cy="90" rx="6.4" ry="7.2" />
                  <ellipse cx="120" cy="90" rx="6.4" ry="7.2" />
                  <circle class="eye-shine" cx="82" cy="87" r="1.9" />
                  <circle class="eye-shine" cx="122" cy="87" r="1.9" />
                </g>
                <g class="eyes eyes--closed">
                  <path d="M73 91q7 7 14 0" />
                  <path d="M113 91q7 7 14 0" />
                </g>
                <g class="eyes eyes--drowsy">
                  <path d="M73 91q7 4 14 0" />
                  <path d="M113 91q7 4 14 0" />
                </g>

                <ellipse class="pet-nose" cx="100" cy="101" rx="6.4" ry="4.8" />
                <path class="pet-mouth pet-mouth--happy" d="M90 110q10 9 20 0" />
                <path class="pet-mouth pet-mouth--hungry" d="M94 110q6 8 12 0" />
                <path class="pet-mouth pet-mouth--sad" d="M90 114q10 -8 20 0" />
                <path class="pet-mouth pet-mouth--sleep" d="M94 112q6 5 12 0" />
              </svg>

              <span class="pet-zzz" aria-hidden="true">Zzz</span>
              <span class="pet-hearts" data-pet-hearts aria-hidden="true"></span>
            </div>

            <div class="pet-gauges">
              <div class="pet-gauge">
                <span class="pet-gauge__label">배부름</span>
                <span
                  class="pet-gauge__bar"
                  role="progressbar"
                  aria-label="배부름"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="72"
                  data-gauge="fullness"
                ><span></span></span>
              </div>
              <div class="pet-gauge">
                <span class="pet-gauge__label">기분</span>
                <span
                  class="pet-gauge__bar"
                  role="progressbar"
                  aria-label="기분"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="68"
                  data-gauge="mood"
                ><span></span></span>
              </div>
              <div class="pet-gauge">
                <span class="pet-gauge__label">기운</span>
                <span
                  class="pet-gauge__bar"
                  role="progressbar"
                  aria-label="기운"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="80"
                  data-gauge="energy"
                ><span></span></span>
              </div>
            </div>
          </div>

          <div class="pet-controls">
            <button class="pet-btn" type="button" data-act="feed">
              <span class="pet-btn__icon" aria-hidden="true">🍚</span>
              <span>밥주기</span>
            </button>
            <button class="pet-btn" type="button" data-act="play">
              <span class="pet-btn__icon" aria-hidden="true">🎾</span>
              <span>놀아주기</span>
            </button>
            <button class="pet-btn" type="button" data-act="sleep">
              <span class="pet-btn__icon" aria-hidden="true">😴</span>
              <span data-sleep-label>재우기</span>
            </button>
            <button class="pet-btn" type="button" data-act="pet">
              <span class="pet-btn__icon" aria-hidden="true">🤚</span>
              <span>쓰다듬기</span>
            </button>
          </div>
        </div>
      </div>

      <aside class="pet-side">
        <div class="pet-status">
          <p class="pet-status__day">함께한 지 <strong data-pet-days>1</strong>일</p>
          <p class="pet-status__care">돌본 횟수 <strong data-pet-care>0</strong>번</p>
          <p class="pet-status__hint" data-pet-hint>잘 먹고 잘 놀고 있어요.</p>
        </div>

        <div class="pet-tips">
          <p class="pet-tips__title">이렇게 놀아요</p>
          <ul>
            <li>밥주기(F) · 놀아주기(N) · 재우기(S) · 쓰다듬기(P)</li>
            <li>잠들면 기운이 천천히 다시 차요</li>
            <li>기록은 이 브라우저에만 저장돼요</li>
          </ul>
        </div>

        <button class="pet-reset" type="button" data-pet-reset>기록 지우고 처음부터</button>
      </aside>
    </section>

    <section class="game-info">
      <h2 class="game-info__title">이 게임에 대해</h2>
      <p>
        브라우저에서 바로 도는 작은 다마고치예요. 게이지는 실제 시간이 흐르는 만큼 줄어들고, 잠들면 기운이 다시 차요.
        서버로 보내는 값은 없고, 상태는 이 브라우저 저장소에만 남습니다.
      </p>
      <ul class="game-info__list">
        <li>밥주기 — 배부름을 크게, 기분을 조금 올려요.</li>
        <li>놀아주기 — 기분은 크게 오르지만 기운이 줄어요. 기운이 모자라면 못 놀아요.</li>
        <li>재우기 — 기운을 채우는 동안에는 배고픔이 조금씩 줄어요. 다 자라면 눌러서 깨워요.</li>
        <li>쓰다듬기 — 기분을 살짝 올리고 하트가 떠요.</li>
      </ul>
      <p class="game-back"><a class="text-link" href={withBase('/game/')}>← 게임 전시관으로</a></p>
    </section>
  </div>

  <script>
    import '../../scripts/pet-game.js';
  </script>
</BaseLayout>
