---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GamePreview from '../../components/game/GamePreview.astro';
import { site } from '../../config';
import { absoluteUrl, withBase } from '../../lib/site';
import { gameList } from '../../data/games';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '쿼구리 게임 전시관',
    url: absoluteUrl('/game/'),
    description: '직접 만든 웹 미니 게임을 모아 둔 전시관입니다. 로그인 없이 바로 플레이할 수 있어요.',
    inLanguage: 'ko-KR',
    isPartOf: { '@type': 'WebSite', name: site.name, url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '쿼구리 웹 게임',
    itemListElement: gameList.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: game.title,
      description: game.summary,
      url: absoluteUrl(`/game/${game.slug}/`),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '게임', item: absoluteUrl('/game/') },
    ],
  },
];
---

<BaseLayout
  title="게임"
  description="직접 만든 웹 미니 게임 전시관 — 로그인 없이 바로 플레이할 수 있어요. 모바일 터치와 PC 키보드 모두 지원합니다."
  jsonLd={jsonLd}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="위치 경로">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li aria-current="page">게임</li>
      </ol>
    </nav>

    <header class="page-head page-head--game">
      <p class="section-label">game</p>
      <h1 class="page-head__title">직접 만든 웹 게임</h1>
      <p class="page-head__desc">
        만들고 싶어서 만든 작은 게임들이에요. 설치도, 로그인도 없이 바로 하고, 기록은 이 브라우저에만 남겨 둡니다.
      </p>
    </header>

    <div class="showcase-list">
      {
        gameList.map((game) => (
          <article class="showcase" style={`--accent:${game.accent}`}>
            <div class="showcase__preview">
              <GamePreview kind={game.preview} large />
            </div>
            <div class="showcase__body">
              <div class="showcase__head">
                <h2 class="showcase__title">{game.title}</h2>
                {game.isNew && <span class="badge-new">NEW</span>}
              </div>
              <p class="showcase__lede">{game.summary}</p>
              <ul class="showcase__features">
                {game.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a class="btn btn--play" href={withBase(`/game/${game.slug}/`)}>
                {game.cta}
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <p class="showcase__note">{game.note}</p>
              <p class="showcase__tags">
                {game.tags.map((tag) => <span>#{tag}</span>)}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <section class="game-footnote">
      <p class="game-footnote__label">note</p>
      <p>
        게임은 계속 하나씩 늘려 갈 예정이에요. 점수와 상태는 서버로 보내지 않고 브라우저 저장소에만 남기니,
        기기를 바꾸면 기록은 새로 시작됩니다.
      </p>
      <a class="text-link" href={withBase('/lab/')}>만든 것과 쓴 것 모두 보기 →</a>
    </section>
  </div>
</BaseLayout>
