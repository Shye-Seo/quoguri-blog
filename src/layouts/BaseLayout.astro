---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, adsense, analytics, verification } from '../config';
import { absoluteUrl, asset } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  noindex?: boolean;
  keywords?: string[];
  articleSection?: string;
  articleTags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = `${site.name} 블로그 대표 이미지`,
  type = 'website',
  publishedTime,
  updatedTime,
  noindex = false,
  keywords = site.keywords,
  articleSection,
  articleTags,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image.startsWith('http') ? image : absoluteUrl(image);
const isDefaultImage = ogImage === absoluteUrl(site.ogImage);
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

/**
 * 검색엔진 소유확인
 * ─────────────────────────────────────────────────────────
 * 구글 서치콘솔·네이버 서치어드바이저에서 'HTML 태그' 방식을 고르면
 * 아래 같은 태그가 나옵니다. 그 content 값만 src/config.ts 의
 * verification.google / verification.naver 에 넣거나,
 * GitHub 저장소 변수 PUBLIC_GOOGLE_SITE_VERIFICATION /
 * PUBLIC_NAVER_SITE_VERIFICATION 로 넣으면 자동으로 들어갑니다.
 *
 *   <meta name="google-site-verification" content="여기에_코드" />
 *   <meta name="naver-site-verification" content="여기에_코드" />
 */
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.naver && <meta name="naver-site-verification" content={verification.naver} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.author.name} />
    <meta name="theme-color" content="#faf8f3" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={absoluteUrl('/rss.xml')} />
    <link rel="sitemap" href={absoluteUrl('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content={site.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- 폰트: 제목·UI는 Paperlogy, 본문은 장문 가독성이 좋은 Pretendard -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preload" type="font/woff2" as="font" crossorigin
      href="https://cdn.jsdelivr.net/gh/fonts-archive/Paperlogy/Paperlogy-8ExtraBold.woff2" />

    {
      adsense.enabled && (
        <>
          <meta name="google-adsense-account" content={adsense.client} />
          <script
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.client}`}
            crossorigin="anonymous"
          />
        </>
      )
    }

    {
      analytics.ga4 && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4}`} />
          <script is:inline define:vars={{ ga4: analytics.ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }

    {jsonLdList.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로 가기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
